# Copiar a .env para una instalación nueva y generar las dos claves según README.md.
# Los valores vacíos impiden iniciar la aplicación: nunca se usa una clave compartida.
SECRET_KEY=
FIELD_ENCRYPTION_KEYS=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=cardiounemi_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
