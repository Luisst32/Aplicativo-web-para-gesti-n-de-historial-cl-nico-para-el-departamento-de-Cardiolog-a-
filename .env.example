# Copiar a .env para una instalación nueva y generar las dos claves según README.md.
# Los valores vacíos impiden iniciar la aplicación: nunca se usa una clave compartida.
SECRET_KEY=
FIELD_ENCRYPTION_KEYS=
APP_ENV=production
DEBUG=False
ALLOWED_HOSTS=cardio.example.com
CSRF_TRUSTED_ORIGINS=https://cardio.example.com
# Activar sólo detrás de un proxy controlado que reescriba X-Forwarded-Proto.
TRUST_PROXY_HEADERS=False
SECURE_HSTS_SECONDS=3600

DB_NAME=cardiounemi_db
DB_USER=cardio_runtime
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
